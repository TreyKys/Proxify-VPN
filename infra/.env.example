# Copy to .env and fill in. Never commit the real file.

DATABASE_URL=postgres://proxify:proxify@localhost:5432/proxify?sslmode=disable

# Must be at least 32 bytes outside dev. Rotating it signs every user out.
PROXIFY_JWT_SECRET=

# Guards /v1/admin/*. Leave empty to disable those endpoints entirely.
PROXIFY_ADMIN_TOKEN=

PAYSTACK_SECRET_KEY=
# Only set if the webhook is signed with a different key than the API secret.
PAYSTACK_WEBHOOK_KEY=

PROXIFY_ADDR=:8080
PROXIFY_ENV=dev
PROXIFY_RECONCILE_INTERVAL=20s
PROXIFY_EDGE_TIMEOUT=5s
PROXIFY_FREE_PLAN=true
